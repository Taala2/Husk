+++ b/src/translation-layer-next/husk-tl-bionic.c
@@ -441,6 +441,15 @@ static void bionic_exit(int status)
     char where[200];
     describe_caller(__builtin_return_address(0), where, sizeof(where));
     tl_log_line("bionic: exit(%d) called from %s", status, where);
+    if (status != 0) {
+        /* what a Python app (Ren'Py, Kivy) was told about where it lives: its paths decide where it looks for its own files */
+        static const char *const names[] = { "ANDROID_APK", "ANDROID_PRIVATE", "ANDROID_PUBLIC", "ANDROID_OLD_PUBLIC", "ANDROID_ARGUMENT",
+                                             "ANDROID_ENTRYPOINT", "ANDROID_UNPACK", "ANDROID_EXPANSION", "PYTHONHOME", "PYTHONPATH" };
+        for (size_t i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+            const char *v = getenv(names[i]);
+            if (v) tl_log_line("bionic: env %s=%s", names[i], v);
+        }
+    }
     log_guest_frames(__builtin_frame_address(1));
     if (tl_guest_exit_hook) tl_guest_exit_hook(status);
     exit(status);
