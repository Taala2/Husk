         }
 
+        // A Python app (Ren'Py, Kivy, pygame) that ended on an error of its own script. Python prints the traceback and then calls
+        // exit(1), which looks exactly like a protected app closing itself, so this is checked first. The traceback is the run of
+        // "I/python:" lines right before the exit; its first error is the cause (a later one is only what failed while reporting it).
+        if let ei = lines.lastIndex(where: { $0.contains("bionic: exit(") && $0.contains("called from") }) {
+            var start = ei
+            while start > 0 && lines[start - 1].hasPrefix("I/python:") { start -= 1 }
+            let block = lines[start..<ei].map { String($0.dropFirst("I/python:".count)).trimmingCharacters(in: .whitespaces) }
+            let cause = block.first { l in
+                guard !l.hasPrefix("File "), let c = l.firstIndex(of: ":") else { return false }
+                let name = l[..<c]
+                return !name.contains(" ") && (name.hasSuffix("Error") || name.hasSuffix("Exception"))
+            }
+            if let cause, block.contains(where: { $0.hasPrefix("Traceback") || $0.hasPrefix("Full traceback") }) {
+                return AppDiagnosis(kind: .javaCrash, title: "The game stopped on a script error",
+                                    detail: "The game's own Python code failed: \(cause.prefix(220)). This is not copy protection: the game did not find "
+                                        + "what it expects in the Android environment Husk gives it. The report has the full log.",
+                                    evidence: lines[start])
+            }
+        }
+
         // The app ended itself from native code: protection that found it is not on a certified phone, most of the time
         if let l = lines.last(where: { $0.contains("bionic: exit(") && $0.contains("called from") }),
            let code = l.range(of: "exit\\((\\d+)\\)", options: .regularExpression).map({ String(l[$0]) }), code != "exit(0)" {
